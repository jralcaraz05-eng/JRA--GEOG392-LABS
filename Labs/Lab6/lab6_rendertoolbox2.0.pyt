# -*- coding: utf-8 -*-import arcpyimport osimport timeclass Toolbox(object):    def __init__(self):        """Define the toolbox (the name of the toolbox is the name of the .pyt file)."""        self.label = "Lab6_Toolbox"        self.alias = "Lab6_Toolbox"        # List of tool classes associated with this toolbox        self.tools = [Lab6_Tool]class Lab6_Tool(object):    def __init__(self):        """Define the tool (tool name is the class name)."""        self.label = "Lab 6 Renderer Tool"        self.description = (            "Re-render 'Structures' and 'Trees' layers with a step progress bar "            "and save a new project copy."        )        self.canRunInBackground = False    def getParameterInfo(self):        """Define parameter definitions."""        # 0 - aprx path        aprx_path = arcpy.Parameter(            displayName="Project (.aprx) path",            name="aprx_path",            datatype="DEFile",            parameterType="Required",            direction="Input"        )        # 1 - map name (optional)        map_name = arcpy.Parameter(            displayName="Map name (optional)",            name="map_name",            datatype="GPString",            parameterType="Optional",            direction="Input"        )        map_name.value = "Map"        # 2 - structures layer name        structures_name = arcpy.Parameter(            displayName="Structures layer name",            name="structures_name",            datatype="GPString",            parameterType="Optional",            direction="Input"        )        structures_name.value = "Structures"        # 3 - trees layer name        trees_name = arcpy.Parameter(            displayName="Trees layer name",            name="trees_name",            datatype="GPString",            parameterType="Optional",            direction="Input"        )        trees_name.value = "Trees"        # 4 - output aprx path        output_aprx = arcpy.Parameter(            displayName="Output .aprx path (optional)",            name="output_aprx",            datatype="DEFile",            parameterType="Optional",            direction="Output"        )        return [aprx_path, map_name, structures_name, trees_name, output_aprx]    def isLicensed(self):        """Set whether tool is licensed to execute."""        return True    def updateParameters(self, parameters):        """Modify parameter values before internal validation is performed."""        return    def updateMessages(self, parameters):        """Modify messages created by internal validation for each parameter."""        return    # --- Helper functions ---    def _get_map(self, aprx, map_name):        """Return a map object, using map_name if provided, else first map."""        if map_name:            maps = aprx.listMaps(map_name)            if maps:                return maps[0]        maps = aprx.listMaps()        if not maps:            raise RuntimeError("No maps found in the project.")        return maps[0]    def _rerender_structures(self, lyr):        """Apply UniqueValueRenderer on field 'Type' to the Structures layer."""        sym = lyr.symbology        if not hasattr(sym, "renderer"):            arcpy.AddWarning("Structures layer does not support renderers.")            return        sym.updateRenderer("UniqueValueRenderer")        # depending on ArcGIS Pro version, either 'fields' or 'field1' is used:        if hasattr(sym.renderer, "fields"):            sym.renderer.fields = ["Type"]        else:            sym.renderer.field1 = "Type"        lyr.symbology = sym    def _rerender_trees(self, lyr, aprx):        """Apply GraduatedColorsRenderer on Shape_Area, 5 classes, Oranges ramp."""        sym = lyr.symbology        if not hasattr(sym, "renderer"):            arcpy.AddWarning("Trees layer does not support renderers.")            return        sym.updateRenderer("GraduatedColorsRenderer")        sym.renderer.classificationField = "Shape_Area"        sym.renderer.breakCount = 5        ramps = aprx.listColorRamps("Oranges (5 Classes)")        if ramps:            sym.renderer.colorRamp = ramps[0]        else:            arcpy.AddWarning("Color ramp 'Oranges (5 Classes)' not found. Using default.")        lyr.symbology = sym    def execute(self, parameters, messages):        """The source code of the tool."""        # Read parameters        aprx_path = parameters[0].valueAsText        map_name = parameters[1].valueAsText        structures_name = parameters[2].valueAsText or "Structures"        trees_name = parameters[3].valueAsText or "Trees"        output_aprx = parameters[4].valueAsText        # --- Setup the step progressor ---        readTime = 3   # seconds to pause for screenshots        start = 0        maximum = 100        step = 25        arcpy.SetProgressor("step", "Initializing tool…", start, maximum, step)        arcpy.AddMessage("Initializing tool…")        time.sleep(readTime)        # --- Load project and map ---        aprx = arcpy.mp.ArcGISProject(aprx_path)        m = self._get_map(aprx, map_name)        arcpy.SetProgressorPosition(start + step)        arcpy.SetProgressorLabel("Finding layers in map…")        arcpy.AddMessage(f"Using map: {m.name}")        time.sleep(readTime)        # Dictionary of feature layers by name        layers = {lyr.name: lyr for lyr in m.listLayers() if lyr.isFeatureLayer}        # --- Re-render Structures ---        if structures_name in layers:            arcpy.AddMessage(f"Re-rendering '{structures_name}' as Unique Values on 'Type'...")            self._rerender_structures(layers[structures_name])        else:            arcpy.AddWarning(f"Structures layer '{structures_name}' not found in map.")        arcpy.SetProgressorPosition(start + 2 * step)        arcpy.SetProgressorLabel("Re-rendering Structures layer…")        time.sleep(readTime)        # --- Re-render Trees ---        if trees_name in layers:            arcpy.AddMessage(                f"Re-rendering '{trees_name}' as Graduated Colors on 'Shape_Area' (5 classes, Oranges)…"            )            self._rerender_trees(layers[trees_name], aprx)        else:            arcpy.AddWarning(f"Trees layer '{trees_name}' not found in map.")        arcpy.SetProgressorPosition(start + 3 * step)        arcpy.SetProgressorLabel("Re-rendering Trees layer…")        time.sleep(readTime)        # --- Save updated project into a new copy ---        if not output_aprx:            folder = os.path.dirname(aprx_path)            base = os.path.splitext(os.path.basename(aprx_path))[0]            output_aprx = os.path.join(folder, f"{base}_new.aprx")        aprx.saveACopy(output_aprx)        arcpy.SetProgressorPosition(maximum)        arcpy.SetProgressorLabel("Saving the project…")        arcpy.AddMessage(f"Saving updated project to: {output_aprx}")        time.sleep(readTime)        return